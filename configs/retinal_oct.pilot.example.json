{
  "outputs_dir": "outputs",
  "dataset": {
    "name": "retinal_oct",
    "adapter": "retinal_oct",
    "root": "data/retinal_oct_pilot",
    "grayscale_compatible": false
  },
  "experiment": {
    "seed": 42,
    "deterministic": true,
    "preprocessing": "P0",
    "preprocessing_arms": ["P0"]
  },
  "data": {
    "image_size": 128,
    "split_ratios": [0.7, 0.15, 0.15],
    "imagenet_normalization": true
  },
  "training": {
    "epochs": 1,
    "batch_size": 8,
    "learning_rate": 0.0001,
    "workers": 0,
    "device": "cpu",
    "pretrained": false
  }
}
